# ---- Local development -----------------------------------------------
# Copy to .env and adjust if needed. Defaults in the code match these
# values, so this file is only needed if you run scripts outside of
# `npm run local:*` (which sets variables automatically via docker-compose).

# DynamoDB Local
DYNAMODB_ENDPOINT=http://localhost:8000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# SQS Local (ElasticMQ)
SQS_ENDPOINT=http://localhost:9324

# DynamoDB table names
MENTORS_TABLE=mentors
STUDENTS_TABLE=students
TIME_SLOTS_TABLE=timeslots
BOOKINGS_TABLE=bookings

# SQS queue URLs
NOTIFICATIONS_QUEUE_URL=http://localhost:9324/000000000000/notifications
EXPORTS_QUEUE_URL=http://localhost:9324/000000000000/exports

# SNS topic ARN (only needed if you test notification fanout locally)
NOTIFICATIONS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:notifications

# S3 bucket names (only needed for import/export endpoints)
IMPORTS_BUCKET=imports
EXPORTS_BUCKET=exports

# Admin email for protected routes
ADMIN_EMAIL=admin@example.com

# Local server port
PORT=3001
